{
  "schema_version": "stereo_pose_learning_v1",
  "image_size": [
    360,
    640
  ],
  "window": 8,
  "model": {
    "backbone": "convnextv2_nano.fcmae_ft_in22k_in1k",
    "pretrained": true,
    "feature_dim": 128,
    "token_grid": [
      6,
      10
    ],
    "fusion_layers": 2,
    "attention_heads": 4,
    "hidden_dim": 256,
    "depth_scale_mm": 100.0,
    "channels_last": false
  },
  "training": {
    "seed": 20261109,
    "epochs": 100,
    "batch_size": 4,
    "accumulate": 1,
    "backbone_lr": 1e-05,
    "head_lr": 0.0001,
    "weight_decay": 0.01,
    "warmup_epochs": 5,
    "patience": 15,
    "clip_grad_norm": 1.0,
    "amp": true,
    "workers": 4,
    "pin_memory": true,
    "prefetch_factor": 2,
    "persistent_workers": true,
    "async_transfer": true,
    "shared_frame_cache": true,
    "cpu_threads": 4,
    "fused_optimizer": true,
    "keep_epoch_checkpoints": 2
  },
  "loss_weights": {
    "position": 1.0,
    "rotation": 1.0,
    "joints": 0.1,
    "geometry": 1.0,
    "part_rotation": 0.25,
    "projection": 0.2,
    "depth": 0.1,
    "mask": 0.1,
    "heatmap": 1.0
  },
  "loss_scales": {
    "position_scale_mm": 10.0,
    "projection_scale_px": 20.0,
    "joint_scale_deg": [
      10.0,
      10.0,
      5.0
    ]
  },
  "expected_pairs": {
    "train": 1400,
    "validation": 350,
    "test": 350
  }
}
