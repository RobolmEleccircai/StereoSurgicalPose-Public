                            uniform token[] xformOpOrder = ["xformOp:translate"]
                        }
                    }
                }
            }

            over "psm_tool_gripper2_link"
            {
                over "visuals_xform"
                {
                    over "gripper_left"
                    {
                        def Xform "DistalTipReference"
                        {
