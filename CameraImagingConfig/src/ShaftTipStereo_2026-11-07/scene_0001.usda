                    uniform token[] xformOpOrder = ["xformOp:translate"]
                }
            }

            over "psm_tool_gripper1_link"
            {
                over "visuals_xform"
                {
                    over "gripper_right"
                    {
                        def Xform "DistalTipReference"
                        {
                            double3 xformOp:translate = (0.00028500000674587983, 0.009651999920606613, -0.000013999999888862172)
                            uniform token[] xformOpOrder = ["xformOp:translate"]
                        }
                    }
                }
            }

            over "psm_tool_gripper2_link"
            {
                over "visuals_xform"
                {
                    over "gripper_left"
                    {
                        def Xform "DistalTipReference"
                        {
                            double3 xformOp:translate = (-0.00028500000674587983, 0.009651999920606613, -0.000010999999782749606)
                            uniform token[] xformOpOrder = ["xformOp:translate"]
                        }
                    }
                }
