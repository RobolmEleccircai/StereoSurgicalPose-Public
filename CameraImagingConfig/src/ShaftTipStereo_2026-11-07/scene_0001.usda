over "SurgicalTools"
{
    over "PSM_Right"
    {
        matrix4d xformOp:transform = ( (49.38056442629398, -58.43537895625052, -64.39616714665573, 0), (-56.18393615840119, 35.08165831489382, -74.91757182147414, 0), (66.36961032497727, 73.1750212580525, -15.50777512070113, 0), (-0.06645737299402477, 108.10325198160996, -11.23431335059894, 1) )
        uniform token[] xformOpOrder = ["xformOp:transform"]

        over "Robot"
        {
            over "psm_tool_roll_link"
            {
                def Xform "ShaftAxisReference" (
                    doc = "Shaft-axis reference: psm_tool_roll_link origin; +Z points toward the distal wrist. Non-rendering ground-truth frame."
                )
                {
                    custom double3 label:axisDirectionLocal = (0, 0, 1)
