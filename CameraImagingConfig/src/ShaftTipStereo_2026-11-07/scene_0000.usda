        matrix4d xformOp:transform = ( (25.289885515764364, -64.33370969475847, -72.260608131333, 0), (-64.33370969475847, 44.60152776284686, -62.22441255753676, 0), (72.26060813133303, 62.22441255753678, -30.108586721388775, 0), (1.4850542231745019, 107.68990725513632, -11.78543965256379, 1) )
        uniform token[] xformOpOrder = ["xformOp:transform"]

        over "Robot"
